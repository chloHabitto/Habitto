    "progress.difficulty.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Difficulty measures how challenging your habits felt when you completed them. After completing a habit, you rate it from Very Easy (1) to Very Hard (5). The stat shown here is the average difficulty of all your scheduled habits for this day."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "난이도는 습관을 완료했을 때 얼마나 어려웠는지를 나타냅니다. 습관 완료 후 매우 쉬움(1)부터 매우 어려움(5)까지 평가합니다. 여기 표시되는 통계는 해당 날짜 예정 습관의 평균 난이도입니다."
          }
        }
      }
    },
    "progress.difficulty.howChallengingMonth": {
