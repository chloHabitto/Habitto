    "more.terms.section5Content" : {
      "comment" : "LEGAL — requires professional/legal translation review",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IMPORTANT: Habitto is designed for general wellness and habit tracking purposes only. The App is NOT intended to:\n\n• Provide medical advice, diagnosis, or treatment\n• Replace professional medical consultation\n• Guarantee specific health outcomes\n• Treat or prevent any medical conditions\n\n• Always consult with qualified healthcare professionals for medical concerns\n• Do not rely on the App for medical decisions\n• The App is not a substitute for professional medical care\n• Results may vary and are not guaranteed\n\nBy using the App, you acknowledge that you are responsible for your own health decisions and will consult healthcare professionals when appropriate."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "IMPORTANT: Habitto is designed for general wellness and habit tracking purposes only. The App is NOT intended to:\n\n• Provide medical advice, diagnosis, or treatment\n• Replace professional medical consultation\n• Guarantee specific health outcomes\n• Treat or prevent any medical conditions\n\n• Always consult with qualified healthcare professionals for medical concerns\n• Do not rely on the App for medical decisions\n• The App is not a substitute for professional medical care\n• Results may vary and are not guaranteed\n\nBy using the App, you acknowledge that you are responsible for your own health decisions and will consult healthcare professionals when appropriate."
          }
        }
