    "more.privacy.section1Content" : {
      "comment" : "LEGAL — requires professional/legal translation review",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We collect information you provide directly to us and information we obtain automatically when you use the App:\n\n**Information You Provide:**\n• Account information (email, name)\n• Habit data and goals\n• Progress tracking information\n• User preferences and settings\n\n**Information We Collect Automatically:**\n• App usage data and analytics\n• Device information (model, OS version)\n• Performance and crash data\n• Interaction patterns within the app"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We collect information you provide directly to us and information we obtain automatically when you use the App:\n\n**Information You Provide:**\n• Account information (email, name)\n• Habit data and goals\n• Progress tracking information\n• User preferences and settings\n\n**Information We Collect Automatically:**\n• App usage data and analytics\n• Device information (model, OS version)\n• Performance and crash data\n• Interaction patterns within the app"
          }
        }
      }
    },
