    "more.privacy.section4Content" : {
      "comment" : "LEGAL — requires professional/legal translation review",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use third-party services to provide app functionality:\n\n**Firebase Services (Google):**\n• Authentication and user management\n• Cloud database for habit data\n• Analytics and crash reporting\n• Push notifications\n\n**Data Processing:**\n• All third-party services comply with GDPR\n• Data processing agreements in place\n• Limited to necessary app functionality\n• No additional data sharing beyond required services"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "We use third-party services to provide app functionality:\n\n**Firebase Services (Google):**\n• Authentication and user management\n• Cloud database for habit data\n• Analytics and crash reporting\n• Push notifications\n\n**Data Processing:**\n• All third-party services comply with GDPR\n• Data processing agreements in place\n• Limited to necessary app functionality\n• No additional data sharing beyond required services"
          }
        }
      }
    },
